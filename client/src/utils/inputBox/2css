.signIn__inputContainer {
  padding: 15px 0;
}

.signIn__inputCredentialContainer {
  -webkit-border-radius: 10px;
  -moz-border-radius: 10px;
  -ms-border-radius: 10px;
  -o-border-radius: 10px;
}

.signIn__inputContainer > input {
  position: absolute;
  top: 70%;
  left: 10px;
  width: 100%;
  height: 100%;
  border: none;
  /* outline: none; */
  padding: 10px;
  font-size: 1rem;
  color: var(--x-text-primary);
  background-color: transparent;
  font-family: "Helvetica";
  outline: none;
}

.signIn__inputCredentialContainer :focus {
}

.signIn__labelContainer {
  position: relative;

  width: 70%;
  height: 100%;
}

.signIn__labelContainer > label {
  position: absolute;
  width: 100%;
  top: 50%;
  left: 10px;
  transform: translateY(-50%);
  color: var(--x-text-secondary);
  font-size: 0.9rem;
  pointer-events: none;
  transition: all 0.3s ease-in;
  -webkit-transition: all 0.3s ease-in;
  -moz-transition: all 0.3s ease-in;
  -ms-transition: all 0.3s ease-in;
  -o-transition: all 0.3s ease-in;
}
.signIn__inputContainer > input:focus + label,
.signIn__inputContainer > input:not(:placeholder-shown) + label {
  top: -10px;
  left: 10px;
  font-size: 0.8rem;
  color: var(--x-text-primary);
}
